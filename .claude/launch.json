{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vod-review",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "-p",
        "aimview-server",
        "--release",
        "--",
        "--port",
        "8770"
      ],
      "port": 8770
    },
    {
      "name": "ui",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4200
    },
    {
      "name": "ui-server",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:server",
        "--port",
        "4201"
      ],
      "port": 4201
    },
    {
      "name": "model-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "python/model/web/serve_static.py",
        "--port",
        "8772"
      ],
      "port": 8772
    },
    {
      "name": "label-check",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "python/model/label_check.py",
        "--n",
        "400",
        "--port",
        "8773"
      ],
      "port": 8773
    },
    {
      "name": "label-valorant",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "python/model/label_check.py",
        "--n",
        "100",
        "--port",
        "8774",
        "--data",
        "test_out/vod_model/hand/valorant",
        "--out",
        "test_out/vod_model/hand/valorant/checked.jsonl"
      ],
      "port": 8774
    },
    {
      "name": "label-batch2",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "python/model/label_check.py",
        "--n",
        "200",
        "--port",
        "8775",
        "--data",
        "test_out/vod_model/hand/batch2",
        "--out",
        "test_out/vod_model/hand/batch2/checked.jsonl"
      ],
      "port": 8775
    }
  ]
}
