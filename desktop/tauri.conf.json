{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aim View",
  "version": "0.1.0",
  "identifier": "app.aimview.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev:desktop --port 4202",
      "cwd": ".."
    },
    "devUrl": "http://localhost:4202",
    "beforeBuildCommand": {
      "script": "bun run build:desktop",
      "cwd": ".."
    },
    "frontendDist": "../ui/dist/desktop/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aim View",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../python/model/models.json": "models/models.json",
      "../python/model/exports/detector_full_v3_u8in.onnx": "models/detector_full_v3_u8in.onnx",
      "../python/model/exports/detector_small_v13_u8in.onnx": "models/detector_small_v13_u8in.onnx",
      "../python/model/exports/detector_small_v11_u8in.onnx": "models/detector_small_v11_u8in.onnx"
    }
  }
}
