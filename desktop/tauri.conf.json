{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aim View",
  "version": "0.1.0",
  "identifier": "app.aimview.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev:desktop --port 4202",
      "cwd": ".."
    },
    "devUrl": "http://localhost:4202",
    "beforeBuildCommand": {
      "script": "bun run build:desktop",
      "cwd": ".."
    },
    "frontendDist": "../ui/dist/desktop/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aim View",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "resources": {
      "../ui/generated/models/": "models/"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/aim-view/libwebgpu_dawn.so": "../target/release/libwebgpu_dawn.so"
        },
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib/aim-view/libwebgpu_dawn.so": "../target/release/libwebgpu_dawn.so"
        }
      }
    }
  }
}
